    "wire": {
        "id": 109,
        "name": "Odd links",
        "visible": true,
        "permalink": "javascript:alert(1)",
        "image": "https://example.test/i.png"
    },
    "expected_document": {
        "id": "109",
        "name": "Odd links",
        "description": "",
        "sku": "",
        "skus": [],
        "brand": "",
        "categories": [],
        "in_stock": false,
        "on_sale": false,
        "visible": true,
        "popularity_score": 0,
        "permalink": "",
        "image": "https://example.test/i.png"
    }
}
